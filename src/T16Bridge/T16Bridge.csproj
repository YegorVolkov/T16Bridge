<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>T16Bridge</AssemblyName>
    <RootNamespace>T16Bridge</RootNamespace>
    <Version>0.1.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
      <ApplicationIcon>..\..\assets\T16Bridge.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="HIDMaestro.Core">
      <HintPath>lib\HIDMaestro.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HidSharp" Version="2.6.4" />
  </ItemGroup>

  <Target Name="CheckHIDMaestro" BeforeTargets="ResolveReferences" Condition="!Exists('lib\HIDMaestro.Core.dll')">
    <Error Text="HIDMaestro.Core.dll is missing. Run scripts\prepare-deps.ps1 first." />
  </Target>
</Project>
